# Base URL API backend.
#
# Kosongkan / hapus baris ini  -> pakai "/api/v1" (same-origin).
#   - dev: di-proxy Vite ke backend (lihat vite.config.ts).
#   - prod: nginx yang mem-proxy /api/ ke backend, panel disajikan dari domain/IP yang sama.
#
# Isi HANYA jika API di origin berbeda, mis. https://api.sekolah.sch.id/api/v1
# (harus lengkap sampai /api/v1). Nilai kosong tetap jatuh ke default.
VITE_API_BASE_URL=
